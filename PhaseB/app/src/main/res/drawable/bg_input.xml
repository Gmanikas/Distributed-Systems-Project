<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"

    android:shape="rectangle">
    
    <!-- Το εσωτερικό χρώμα του πεδίου (Λευκό) -->
    <solid android:color="#FFFFFF" />
    
    <!-- Το περίγραμμα (Border) -->
    <stroke
        android:width="1dp"
        android:color="#BDBDBD" /> <!-- Απαλό γκρι περίγραμμα -->
    
    <!-- Στρογγυλεμένες γωνίες -->
    <corners android:radius="8dp" />
    
    <!-- Εσωτερικά περιθώρια (Padding) -->
    <padding
        android:left="12dp"
        android:top="12dp"
        android:right="12dp"
        android:bottom="12dp" />
</shape>
