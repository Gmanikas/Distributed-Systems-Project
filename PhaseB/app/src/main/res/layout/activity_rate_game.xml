<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rate_game"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:padding="20dp">

    <!-- HEADER: PLAYER INFO & BALANCE ΜΕ ΕΙΚΟΝΙΔΙΑ (ΕΥΘΥΓΡΑΜΜΙΣΜΕΝΑ) -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="20dp">

        <TextView
            android:id="@+id/tvPlayerId"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:text=" Player ID: (Όνομα)"
            android:textColor="#000000"
            android:textStyle="bold"
            android:textSize="14sp"
            android:gravity="center_vertical"
            android:drawableStart="@drawable/ic_account_box"
            android:drawablePadding="8dp" />

        <TextView
            android:id="@+id/tvBalance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:text=" Balance: 1000,00 FUN"
            android:textColor="#000000"
            android:textSize="14sp"
            android:textStyle="bold"
            android:gravity="center_vertical"
            android:drawableStart="@drawable/ic_wallet"
            android:drawablePadding="8dp" />
    </RelativeLayout>

    <!-- CENTER: SLOT MACHINE ICON -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🎰"
        android:textSize="90sp"
        android:gravity="center"
        android:layout_marginBottom="20dp" />

    <!-- ΣΕΙΡΑ 1: GAME NAME INPUT -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Game Name:"
            android:textColor="#000000"
            android:textStyle="bold"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/etRateGameName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp" 
            android:layout_marginStart="10dp"
            android:background="@android:drawable/editbox_background"
            android:hint="Enter name..."
            android:padding="10dp"
            android:textSize="16sp"
            android:textColor="#000000" />
    </LinearLayout>

    <!-- ΣΕΙΡΑ 2: RATING (48sp) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="30dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Rating:"
            android:textColor="#000000"
            android:textStyle="bold"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/etRatingStars"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:background="@android:drawable/editbox_background"
            android:hint="0"
            android:textSize="48sp"
            android:textStyle="bold"
            android:inputType="number"
            android:gravity="center"
            android:textColor="#000000" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="stars"
            android:textColor="#000000"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginStart="10dp" />
    </LinearLayout>

    <!-- SUBMIT BUTTON -->
    <Button
        android:id="@+id/btnSubmitRating"
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:text="SUBMIT"
        android:gravity="center"
        android:backgroundTint="#5C6BC0"
        android:textColor="#000000"
        android:textSize="22sp"
        android:textStyle="bold" />

</LinearLayout>
