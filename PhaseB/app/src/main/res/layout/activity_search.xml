<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://android.com"
    android:id="@+id/search"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:padding="20dp">

    <!-- ΠΑΝΩ ΜΙΣΟ: PLAYER INFO & SLOT MACHINE -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.7"
        android:orientation="vertical"
        android:padding="20dp"
        android:gravity="center_horizontal">

        <!-- HEADER ΜΕ ΕΙΚΟΝΙΔΙΑ ΚΑΙ ΕΥΘΥΓΡΑΜΜΙΣΗ -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="20dp">

            <TextView
                android:id="@+id/tvPlayerId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:gravity="center_vertical"
                android:text="Player ID: User123"
                android:textColor="#000000"
                android:textStyle="bold"
                android:textSize="14sp"
                android:drawableStart="@drawable/ic_account_box"
                android:drawablePadding="8dp" />

            <TextView
                android:id="@+id/tvBalance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:gravity="center_vertical"
                android:text="Balance: 1000 FUN"
                android:textColor="#000000"
                android:textSize="14sp"
                android:textStyle="bold"
                android:drawableStart="@drawable/ic_wallet"
                android:drawablePadding="8dp" />
        </RelativeLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎰"
            android:textSize="90sp" />
    </LinearLayout>

    <!-- ΚΑΤΩ ΜΙΣΟ: ΦΙΛΤΡΑ (ΜΕΤΑΚΙΝΗΜΕΝΑ ΠΡΟΣ ΤΑ ΠΑΝΩ) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.3"
        android:orientation="vertical"
        android:background="#F9F9F9"
        android:paddingLeft="24dp"
        android:paddingRight="24dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:elevation="10dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="MINIMUM STARS"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:layout_marginBottom="2dp" />
        <Spinner
            android:id="@+id/spMinStars"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="8dp"
            android:entries="@array/minimum_stars"
            android:background="@android:drawable/btn_dropdown" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CATEGORY"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:layout_marginBottom="2dp" />
        <Spinner
            android:id="@+id/spBetCat"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="8dp"
            android:entries="@array/category"
            android:background="@android:drawable/btn_dropdown" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="RISK LEVEL"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:layout_marginBottom="2dp" />
        <Spinner
            android:id="@+id/spRisk"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="12dp"
            android:entries="@array/risk_level"
            android:background="@android:drawable/btn_dropdown" />

        <Button
            android:id="@+id/btnSubmitSearch"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:onClick="handleSearch"
            android:text="SUBMIT"
            android:backgroundTint="#5C6BC0"
            android:textColor="#000000"
            android:textSize="18sp"
            android:textStyle="bold"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:gravity="center" />
    </LinearLayout>

         <!-- HOME BUTTON (ΜΕΤΑΚΙΝΗΜΕΝΟ ΠΡΟΣ ΤΑ ΠΑΝΩ) -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp" />

    <ImageButton
        android:id="@+id/btnHome"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="10dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:onClick="handleSearchHomeButton"
        android:contentDescription="Home Button"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_home"
        app:srcCompat="@drawable/ic_home"
        android:tint="#5C6BC0" />

</LinearLayout>
