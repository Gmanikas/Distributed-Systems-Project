<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"


    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <TextView
            android:id="@+id/tvGameTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cyber Poker"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#1A237E"
            android:layout_marginTop="20dp"/>

        <TextView
            android:id="@+id/tvGameDetails"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Risk: MEDIUM | Jackpot: 20x"
            android:textColor="#757575"
            android:layout_marginBottom="40dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ποσό πονταρίσματος (FUN)"
            android:textSize="12sp"
            android:textColor="#757575"
            android:layout_marginBottom="4dp"/>

        <EditText
            android:id="@+id/etBetAmount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:hint="Εισάγετε ποσό..."
            android:inputType="numberDecimal"
            android:padding="16dp"
            android:background="@android:drawable/editbox_background"
            android:textSize="20sp"
            android:layout_marginBottom="24dp"/>

        <Button
            android:id="@+id/btnPlayAction"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="🎰  ΠΟΝΤΑΡΕ ΤΩΡΑ!"
            android:backgroundTint="#1A237E"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="18sp"/>

        <ProgressBar
            android:id="@+id/progressBarPlay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:visibility="gone" />

        <!-- Κάρτα Αποτελέσματος -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:visibility="gone"
            app:cardCornerRadius="12dp"
            app:cardElevation="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp"
                android:gravity="center">

                <TextView
                    android:id="@+id/tvResultStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ΝΙΚΗ! 💰"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="#2E7D32" />

                <TextView
                    android:id="@+id/tvResultAmount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="+50.0 FUN"
                    android:textSize="20sp"
                    android:layout_marginTop="8dp" />

                <TextView
                    android:id="@+id/tvNewBalanceInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Νέο Υπόλοιπο: 1050.0 FUN"
                    android:textSize="14sp"
                    android:textColor="#757575"
                    android:layout_marginTop="12dp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>
</ScrollView>





