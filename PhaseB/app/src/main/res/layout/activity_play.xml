<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://android.com"
    android:id="@+id/play"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <!-- ΚΥΡΙΟ ΠΕΡΙΕΧΟΜΕΝΟ ΠΑΙΧΝΙΔΙΟΥ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="20dp"
        android:gravity="center_horizontal">

        <!-- PLAYER INFO HEADER -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="20dp">

            <TextView
                android:id="@+id/tvPlayerId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:gravity="center_vertical"
                android:text="Player ID: User123"
                android:textColor="#000000"
                android:textStyle="bold"
                android:textSize="14sp"
                android:drawableStart="@drawable/ic_account_box"
                android:drawablePadding="8dp" />

            <TextView
                android:id="@+id/tvBalance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:gravity="center_vertical"
                android:text="Balance: 1000 FUN"
                android:textColor="#000000"
                android:textSize="14sp"
                android:textStyle="bold"
                android:drawableStart="@drawable/ic_wallet"
                android:drawablePadding="8dp" />
        </RelativeLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvGamePlay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp" />

<!--        &lt;!&ndash; GAME LOGO &ndash;&gt;-->
<!--        <ImageView-->
<!--            android:id="@+id/ivGameLogo"-->
<!--            android:layout_width="120dp"-->
<!--            android:layout_height="120dp"-->
<!--            android:src="@drawable/cyber_poker"-->
<!--            android:layout_marginBottom="8dp"-->
<!--            android:scaleType="centerInside"-->
<!--            android:contentDescription="Game Logo" />-->

<!--        <TextView-->
<!--            android:id="@+id/tvGameTitle"-->
<!--            android:layout_width="wrap_content"-->
<!--            android:layout_height="wrap_content"-->
<!--            android:text="Cyber Poker"-->
<!--            android:textSize="26sp"-->
<!--            android:textStyle="bold"-->
<!--            android:textColor="#1A237E" />-->

<!--        <TextView-->
<!--            android:id="@+id/tvGameDetails"-->
<!--            android:layout_width="wrap_content"-->
<!--            android:layout_height="wrap_content"-->
<!--            android:text="Risk: MEDIUM | Jackpot: 20x"-->
<!--            android:textColor="#757575"-->
<!--            android:layout_marginBottom="30dp"/>-->

        <!-- INPUT SECTION -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="BET AMOUNT (FUN)"
            android:textSize="12sp"
            android:textColor="#757575"
            android:layout_marginBottom="4dp"/>

        <EditText
            android:id="@+id/etBetAmount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:hint="Enter amount..."
            android:inputType="numberDecimal"
            android:padding="16dp"
            android:background="@android:drawable/editbox_background"
            android:textSize="20sp"
            android:layout_marginBottom="24dp"/>

        <Button
            android:id="@+id/btnPlayAction"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:onClick="handleBet"
            android:text="🎰  BET NOW!"
            android:backgroundTint="#1A237E"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="18sp"/>

        <ProgressBar
            android:id="@+id/progressBarPlay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:visibility="gone" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- HOME BUTTON -->
    <ImageButton
        android:id="@+id/btnHome"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="30dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_home"
        android:onClick="handlePlayHomeButton"
        android:contentDescription="Home Button"
        android:tint="#5C6BC0" />

    <!-- ΜΗΝΥΜΑΤΑ ΑΠΟΤΕΛΕΣΜΑΤΟΣ (ΣΤΟ ΚΕΝΤΡΟ) -->
    <LinearLayout
        android:id="@+id/llResultContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center">

        <include
            android:id="@+id/includeWinCard"
            layout="@layout/activity_win"
            android:visibility="gone" />

        <include
            android:id="@+id/includeLossCard"
            layout="@layout/activity_loss"
            android:visibility="gone" />
    </LinearLayout>

</FrameLayout>
