<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/login"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:padding="32dp"
    android:gravity="center_horizontal">

    <!-- WELCOME TEXT -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="WELCOME TO OUR 24/7 CASINO !"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#333333"
        android:layout_marginTop="40dp" />

    <!-- SLOT MACHINE ICON -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🎰"
        android:textSize="100sp"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="16dp" />

    <!-- TERMINAL TITLE -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="CASINO PLAYER TERMINAL"
        android:textSize="16sp"
        android:fontFamily="monospace"
        android:textStyle="bold"
        android:textColor="#D4AF37"
        android:layout_marginBottom="40dp" />

    <!-- PLAYER ID INPUT (Με μεγαλύτερο hint) -->
    <EditText
        android:id="@+id/etPlayerId"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="65dp"
        android:hint="Enter Your ID"
        android:textColorHint="#999999"
        android:textSize="20sp" 
        android:inputType="text"
        android:padding="16dp"
        android:background="@android:drawable/editbox_background"
        android:textColor="#000000"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp" />

    <!-- ΜΠΛΕ ΚΟΥΜΠΙ SUBMIT ΜΕ ΜΑΥΡΑ ΓΡΑΜΜΑΤΑ ΣΤΟ ΚΕΝΤΡΟ -->
    <Button
        android:id="@+id/btnSubmit"
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:onClick="handleLogin"
        android:text="SUBMIT"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#000000"
        android:backgroundTint="#5C6BC0"
        android:gravity="center"
        android:elevation="4dp" />

</LinearLayout>
