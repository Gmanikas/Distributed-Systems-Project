<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://android.com"
    android:id="@+id/change_player"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:padding="32dp"
    android:gravity="center_horizontal">

    <!-- SLOT MACHINE ICON -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🎰"
        android:textSize="100sp"
        android:layout_marginTop="50dp"
        android:layout_marginBottom="16dp" />

    <!-- TERMINAL TITLE -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="CASINO PLAYER TERMINAL"
        android:textSize="18sp"
        android:fontFamily="monospace"
        android:textStyle="bold"
        android:textColor="#D4AF37"
        android:layout_marginBottom="40dp" />

    <!-- ΟΡΘΟΓΩΝΙΟ ΓΙΑ CHANGE ID -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@android:drawable/dialog_holo_light_frame"
        android:padding="20dp"
        android:layout_marginBottom="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Change Your ID"
            android:textSize="14sp"
            android:textColor="#757575"
            android:layout_marginBottom="8dp"
            android:drawableStart="@drawable/ic_account_box"
            android:drawablePadding="8dp"
            android:gravity="center_vertical" />

        <EditText
            android:id="@+id/etChangePlayerId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:hint="Enter new ID..."
            android:inputType="text"
            android:background="@android:drawable/editbox_background"
            android:padding="12dp"
            android:textColor="#000000" />
    </LinearLayout>

    <!-- SUBMIT BUTTON -->
    <Button
        android:id="@+id/btnSubmitChange"
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:onClick="handleReLogin"
        android:text="SUBMIT"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#000000"
        android:backgroundTint="#5C6BC0"
        android:gravity="center"
        android:elevation="4dp"
        android:insetTop="0dp"
        android:insetBottom="0dp" />

    <!-- SPACE FILLER (Ελατήριο για να σπρώξει το Home κάτω) -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- HOME BUTTON -->
    <ImageButton
        android:id="@+id/btnHome"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_marginBottom="10dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:scaleType="fitCenter"
        app:srcCompat="@drawable/ic_home"
        android:layout_gravity="center_horizontal"
        android:contentDescription="Home Button" />

</LinearLayout>
