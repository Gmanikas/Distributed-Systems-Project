<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://android.com"
    android:id="@+id/rate"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:padding="20dp">

    <!-- HEADER: PLAYER INFO & BALANCE -->
    <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="20dp">

        <TextView
            android:id="@+id/tvRatePlayerId"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:drawableStart="@drawable/ic_account_box"
            android:drawablePadding="8dp"
            android:gravity="center_vertical"
            android:text="Player ID: (Όνομα)"
            android:textColor="#000000"
            android:textSize="14sp"
            android:textStyle="bold" />

            <TextView
                android:id="@+id/tvRateBalance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:gravity="center_vertical"
                android:text="Balance: 1000 FUN"
                android:textColor="#000000"
                android:textSize="14sp"
                android:textStyle="bold"
                android:drawableStart="@drawable/ic_wallet"
                android:drawablePadding="8dp" />
    </RelativeLayout>

    <!-- CENTER: SLOT MACHINE ICON -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🎰"
        android:textSize="90sp"
        android:gravity="center"
        android:layout_marginBottom="20dp" />

    <!-- ΣΕΙΡΑ 1: GAME NAME INPUT -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Game Name:"
            android:textColor="#000000"
            android:textStyle="bold"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/etRateGameName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp" 
            android:layout_marginStart="10dp"
            android:background="@android:drawable/editbox_background"
            android:hint="Enter name..."
            android:padding="10dp"
            android:textSize="16sp"
            android:textColor="#000000" />
    </LinearLayout>

    <!-- ΣΕΙΡΑ 2: RATING (48sp) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="30dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Rating:"
            android:textColor="#000000"
            android:textStyle="bold"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/etRatingStars"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:background="@android:drawable/editbox_background"
            android:hint="0"
            android:textSize="48sp"
            android:textStyle="bold"
            android:inputType="number"
            android:gravity="center"
            android:textColor="#000000" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="stars"
            android:textColor="#000000"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginStart="10dp" />
    </LinearLayout>

    <!-- SUBMIT BUTTON (ΔΙΟΡΘΩΜΕΝΟ ΓΙΑ ΚΕΝΤΡΑΡΙΣΜΑ) -->
    <Button
        android:id="@+id/btnSubmitRating"
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:onClick="handleRate"
        android:text="SUBMIT"
        android:backgroundTint="#5C6BC0"
        android:textColor="#000000"
        android:textSize="22sp"
        android:textStyle="bold"
        android:gravity="center"
        android:padding="0dp"
        android:insetTop="0dp"
        android:insetBottom="0dp" />

    <!-- ΕΛΑΤΗΡΙΟ ΓΙΑ ΝΑ ΠΑΕΙ ΤΟ HOME ΚΑΤΩ -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- HOME BUTTON -->
    <ImageButton
        android:id="@+id/btnHome"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="10dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:onClick="handleRateHomeButton"
        android:contentDescription="Home Button"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_home"
        app:srcCompat="@drawable/ic_home"
        android:tint="#5C6BC0" />

</LinearLayout>
