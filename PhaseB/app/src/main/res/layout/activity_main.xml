<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5"
    android:padding="24dp"
    android:gravity="center_horizontal">

    <!-- Καλωσόρισμα & Player ID -->
    <TextView
        android:id="@+id/tvWelcome"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="Καλώς ήρθες,"
        android:textSize="18sp"
        android:textColor="#757575" />

    <TextView
        android:id="@+id/tvPlayerIdDisplay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="Player_123"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#1A237E"
        android:layout_marginBottom="24dp" />

    <!-- Πλαίσιο Υπολοίπου (Balance) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@android:drawable/dialog_holo_light_frame"
        android:padding="20dp"
        android:layout_marginBottom="40dp"
        android:gravity="center">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ΔΙΑΘΕΣΙΜΑ TOKENS"
            android:textSize="12sp"
            android:textColor="#757575" />

        <TextView
            android:id="@+id/tvBalance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1000.00 FUN"
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="#2E7D32" />
    </LinearLayout>

    <!-- Κουμπί Αναζήτησης -->
    <Button
        android:id="@+id/btnSearch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="60dp"
        android:layout_marginBottom="12dp"
        android:onClick="handlePlayerIdText"
        android:text="🔍   ΑΝΑΖΗΤΗΣΗ ΠΑΙΧΝΙΔΙΩΝ"
        android:backgroundTint="#1A237E"
        android:textColor="#FFFFFF"
        android:textStyle="bold" />

    <!-- Κουμπί Κατάθεσης -->
    <Button
        android:id="@+id/btnAddBalance"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="60dp"
        android:layout_marginBottom="12dp"
        android:text="💰   ΚΑΤΑΘΕΣΗ FUN"
        android:backgroundTint="#FF8F00"
        android:textColor="#FFFFFF"
        android:textStyle="bold" />

    <!-- Κουμπί Στατιστικών -->
    <Button
        android:id="@+id/btnStats"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="60dp"
        android:layout_marginBottom="30dp"
        android:text="📊   ΤΑ ΣΤΑΤΙΣΤΙΚΑ ΜΟΥ"
        android:backgroundTint="#5C6BC0"
        android:textColor="#FFFFFF"
        android:textStyle="bold" />

    <!-- Κουμπί Αποσύνδεσης -->
    <Button
        android:id="@+id/btnLogout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:minWidth="120dp"
        android:text="ΑΠΟΣΥΝΔΕΣΗ"
        android:backgroundTint="@android:color/transparent"
        android:textColor="#C62828"
        android:textSize="14sp" />

</LinearLayout>
